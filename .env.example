# Application
APP_ENV=development
APP_NAME=vacancy-platform
LOG_LEVEL=INFO
DEBUG=false

# PostgreSQL
POSTGRES_USER=vacancy
POSTGRES_PASSWORD=vacancy
POSTGRES_DB=vacancy
POSTGRES_PORT=5432
DATABASE_URL=postgresql+psycopg://vacancy:vacancy@localhost:5432/vacancy

# Redis / Celery
REDIS_URL=redis://localhost:6379/0
REDIS_PORT=6379

# API / Frontend ports (docker-compose)
API_PORT=8000
FRONTEND_PORT=5173
HTTP_PORT=8080

# Secrets — fill locally; never commit real values
TELEGRAM_BOT_TOKEN=

# VK API (service token preferred for wall.get / collection)
VK_CLIENT_ID=
VK_CLIENT_SECRET=
VK_SERVICE_TOKEN=
VK_TOKEN=
VK_API_VERSION=5.199

# VK auto-publish destination: https://vk.ru/club241679288
# Needs a COMMUNITY token (or user admin token) with «Стена» permission.
# Service token cannot call wall.post.
# Photo upload needs a USER token (photos.getWallUploadServer); otherwise text-only
# or set VK_PUBLISH_PHOTO_ATTACHMENT=photo-{owner}_{id} after one manual upload.
VK_PUBLISH_ENABLED=false
VK_PUBLISH_GROUP_ID=241679288
VK_PUBLISH_TOKEN=
VK_PUBLISH_USER_TOKEN=
VK_PUBLISH_PHOTO_ATTACHMENT=
VK_PUBLISH_INTERVAL_SECONDS=3600

# SuperJob API 2.0 (header X-Api-App-Id = Secret key)
SUPERJOB_CLIENT_ID=
SUPERJOB_SECRET_KEY=

LLM_API_KEY=
SENTRY_DSN=

# Collection tuning
COLLECTION_LOOKBACK_HOURS=48
DEDUP_WINDOW_DAYS=7
VK_POSTS_PER_SOURCE=50
TRUDVSEM_VACANCIES_PER_RUN=100
TRUDVSEM_MAX_PAGES=150
FEED_TARGET_SIZE=30

# Production (Yandex Cloud VM) — see docs/DEPLOY.md
# APP_ENV=production
# Use docker-compose.prod.yml (do not expose Postgres/Redis ports)
# VK_PUBLISH_ENABLED=true
# VK_PUBLISH_INTERVAL_SECONDS=3600
