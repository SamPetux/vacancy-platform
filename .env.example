# Application
APP_ENV=development
APP_NAME=vacancy-platform
LOG_LEVEL=INFO
DEBUG=false

# PostgreSQL
POSTGRES_USER=vacancy
POSTGRES_PASSWORD=vacancy
POSTGRES_DB=vacancy
POSTGRES_PORT=5432
DATABASE_URL=postgresql+psycopg://vacancy:vacancy@localhost:5432/vacancy

# Redis / Celery
REDIS_URL=redis://localhost:6379/0
REDIS_PORT=6379

# API / Frontend ports (docker-compose)
API_PORT=8000
FRONTEND_PORT=5173
HTTP_PORT=8080

# Secrets — fill locally; never commit real values
TELEGRAM_BOT_TOKEN=

# VK API (service token preferred for wall.get)
VK_CLIENT_ID=
VK_CLIENT_SECRET=
VK_SERVICE_TOKEN=
VK_TOKEN=
VK_API_VERSION=5.199

# SuperJob API 2.0 (header X-Api-App-Id = Secret key)
SUPERJOB_CLIENT_ID=
SUPERJOB_SECRET_KEY=

LLM_API_KEY=
SENTRY_DSN=

# Collection tuning
COLLECTION_LOOKBACK_HOURS=48
DEDUP_WINDOW_DAYS=7
VK_POSTS_PER_SOURCE=50
TRUDVSEM_VACANCIES_PER_RUN=100
TRUDVSEM_MAX_PAGES=150
FEED_TARGET_SIZE=30
